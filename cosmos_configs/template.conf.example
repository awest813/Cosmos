# Copy this file to cosmos_configs/<your-game>.conf and adjust the values.
# Only *.conf files are built by install_cosmos.command. This *.example file is ignored.

APP_NAME="Example Game (Cosmos)"
BUNDLE_ID="com.cosmos.example-game"

# Optional overrides.
# ICON_PATH="path/to/custom-icon.icns"  # Default is "app/cosmos/AppIcon.icns"
# APP_VERSION="1.0"
# LS_MINIMUM_SYSTEM_VERSION="11.0"

RUN_ENV_NAMES=(
  STEAM_GAME_ID
  DXMT_CONFIG
  # COSMOS_BACKEND    # recommended | dxmt | d3dmetal | dxvk | wined3d | spockd3d9 (see docs/BACKENDS.md)
  # STEAM_GAME_ARGS   # extra arguments forwarded to the game after -applaunch
)

STEAM_GAME_ID="123456"
DXMT_CONFIG="d3d11.preferredMaxFrameRate=60;"
# COSMOS_BACKEND="dxmt"
# STEAM_GAME_ARGS="-windowed -novid"

# For games auto-detected by detect_steam_games.command, don't edit the generated
# steam-*.conf directly (it is overwritten on refresh). Instead drop persistent
# per-game env in cosmos_configs/overrides/<appid>.env — see overrides/README.md.
