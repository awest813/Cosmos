# Example per-game override for an auto-detected Steam game.
# Copy to "<appid>.env" (drop the .example suffix) to activate, e.g.
#   cp 250900.env.example 250900.env
# then re-run ./detect_steam_games.command to fold it into the generated launcher.
#
# 250900 = The Binding of Isaac: Rebirth

DXMT_CONFIG="d3d11.preferredMaxFrameRate=60;"
STEAM_GAME_ARGS="-windowed"
