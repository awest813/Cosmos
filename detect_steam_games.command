#!/usr/bin/env bash
set -euo pipefail

# Cosmos roadmap milestone 0.2 — auto-detect installed Steam games and turn them
# into launcher configs that install_cosmos.command builds into .app bundles.
#
# It scans the Steam libraries inside the Wine prefix (libraryfolders.vdf +
# appmanifest_*.acf), then writes one generated config per installed game into
# cosmos_configs/ named "steam-<appid>-<slug>.conf". Games that already have a
# hand-curated config (matched by Steam App ID) are skipped so curated presets win.
#
# Usage:
#   detect_steam_games.command            # default: refresh generated configs
#   detect_steam_games.command --list     # print detected games, write nothing
#   detect_steam_games.command --write     # write/refresh generated configs (default)
#   detect_steam_games.command --install   # write configs, then build all launchers

SCRIPT_DIR="${SCRIPT_DIR:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)}"
CONFIGS_DIR="${COSMOS_CONFIGS_DIR:-${SCRIPT_DIR}/cosmos_configs}"
WINEPREFIX="${WINEPREFIX:-$HOME/.wine-steam-11}"

AUTO_HEADER="# AUTO-GENERATED by detect_steam_games.command. Re-run to refresh; edits will be overwritten."
MODE="write"

# Steam App IDs that are tools/runtimes/redistributables rather than games.
IGNORED_APPIDS=" 228980 1070560 1391110 1628350 1493710 "

log() { printf "\n==> %s\n" "$1"; }
die() { printf "Error: %s\n" "$1" >&2; exit 1; }

usage() {
  cat <<'EOF'
Auto-detect installed Steam games and turn them into Cosmos launcher configs.

Usage: detect_steam_games.command [--list|--write|--install]
  --list      Print detected installed Steam games and exit (writes nothing).
  --write     (default) Write/refresh generated configs in cosmos_configs/.
  --install   Write configs, then run install_cosmos.command to build launchers.
EOF
}

parse_arguments() {
  case "${1:-}" in
    ""|--write) MODE="write" ;;
    --list) MODE="list" ;;
    --install) MODE="install" ;;
    --help|-h) usage; exit 0 ;;
    *) die "Unknown argument: $1" ;;
  esac
  (($# <= 1)) || die "This script accepts at most one argument."
}

# True for Steam entries that are tools/runtimes rather than games, so they don't
# become junk launchers (e.g. Steamworks Common Redistributables, Proton, runtimes).
is_ignored_app() {
  local appid="$1" name="$2"
  [[ "${IGNORED_APPIDS}" == *" ${appid} "* ]] && return 0
  printf '%s' "${name}" | grep -Eqi \
    'steamworks common redistributables|steam linux runtime|^proton( |$|-)|^steamvr$' && return 0
  return 1
}

slugify() {
  printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//'
}

# Sanitize a Steam name into something safe for an APP_NAME / .app directory:
# '/' and ':' are not valid in macOS file names, and characters that are special
# inside a double-quoted shell string are escaped because the generated config is
# sourced by install_cosmos.command.
safe_app_name() {
  local name="$1"
  name="${name//\\/}"          # drop backslashes
  name="${name//\//-}"         # '/' not allowed in file names
  name="${name//:/ -}"         # ':' shows as '/' in Finder
  name="${name//\"/}"          # drop double quotes (would close the string)
  name="${name//\$/}"          # drop '$' (no expansion when sourced)
  name="${name//\`/}"          # drop backticks (no command substitution)
  printf '%s' "${name}"
}

# Convert a Windows path from libraryfolders.vdf to a path inside the prefix via
# the prefix's dosdevices drive symlinks (c: -> drive_c, z: -> /, etc.).
win_to_unix() {
  local p="$1"
  p="${p//\\//}"                       # backslashes -> forward slashes
  local drive rest
  drive="$(printf '%s' "${p:0:1}" | tr '[:upper:]' '[:lower:]')"
  rest="${p:2}"                        # strip "X:"
  printf '%s/dosdevices/%s:%s' "${WINEPREFIX}" "${drive}" "${rest}"
}

find_steam_dir() {
  local a="${WINEPREFIX}/drive_c/Program Files (x86)/Steam"
  local b="${WINEPREFIX}/drive_c/Program Files/Steam"
  if [[ -d "${a}" ]]; then printf '%s' "${a}"; elif [[ -d "${b}" ]]; then printf '%s' "${b}"; fi
}

# Print the steamapps directory for every Steam library (newline separated, deduped).
collect_steamapps_dirs() {
  local steam_dir="$1"
  local vdf="${steam_dir}/steamapps/libraryfolders.vdf"
  {
    printf '%s\n' "${steam_dir}/steamapps"
    if [[ -f "${vdf}" ]]; then
      local path
      while IFS= read -r path; do
        [[ -n "${path}" ]] || continue
        printf '%s/steamapps\n' "$(win_to_unix "${path}")"
      done < <(awk -F'"' '$2=="path"{print $4}' "${vdf}")
    fi
  } | awk '!seen[$0]++'
}

# Record Steam App IDs that already have a hand-curated (non auto-generated) config.
curated_appids=""
collect_curated_appids() {
  local cfg aid
  shopt -s nullglob
  for cfg in "${CONFIGS_DIR}"/*.conf; do
    grep -q 'AUTO-GENERATED by detect_steam_games' "${cfg}" && continue
    aid="$(sed -n 's/^STEAM_GAME_ID="\{0,1\}\([0-9][0-9]*\)"\{0,1\}.*/\1/p' "${cfg}" | head -n1)"
    [[ -n "${aid}" ]] && curated_appids+=" ${aid} "
  done
  shopt -u nullglob
}

is_curated() { [[ "${curated_appids}" == *" $1 "* ]]; }

remove_stale_generated() {
  local cfg
  shopt -s nullglob
  for cfg in "${CONFIGS_DIR}"/steam-*.conf; do
    grep -q 'AUTO-GENERATED by detect_steam_games' "${cfg}" && rm -f "${cfg}"
  done
  shopt -u nullglob
}

write_config() {
  local appid="$1" name="$2"
  local slug app_name bundle_id file
  slug="$(slugify "${name}")"
  app_name="$(safe_app_name "${name}") (Cosmos)"
  bundle_id="com.cosmos.steam-${appid}"
  file="${CONFIGS_DIR}/steam-${appid}${slug:+-${slug}}.conf"

  cat > "${file}" <<EOF
${AUTO_HEADER}
# Steam: ${name} (App ID ${appid})
APP_NAME="${app_name}"
BUNDLE_ID="${bundle_id}"

RUN_ENV_NAMES=(
  STEAM_GAME_ID
)

STEAM_GAME_ID="${appid}"
EOF
  printf '%s' "${file}"
}

main() {
  parse_arguments "$@"

  local steam_dir
  steam_dir="$(find_steam_dir)"
  [[ -n "${steam_dir}" ]] || die "Steam not found in the Wine prefix (${WINEPREFIX}). Launch Steam via Cosmos first."

  collect_curated_appids

  # Gather (appid, name) pairs from every library, deduped by appid.
  local -a appids=() names=()
  local seen=""
  local steamapps acf appid name
  while IFS= read -r steamapps; do
    [[ -d "${steamapps}" ]] || continue
    shopt -s nullglob
    for acf in "${steamapps}"/appmanifest_*.acf; do
      appid="${acf##*/appmanifest_}"; appid="${appid%.acf}"
      [[ "${appid}" =~ ^[0-9]+$ ]] || continue
      [[ "${seen}" == *" ${appid} "* ]] && continue
      seen+=" ${appid} "
      name="$(awk -F'"' '$2=="name"{print $4; exit}' "${acf}")"
      [[ -n "${name}" ]] || name="Steam App ${appid}"
      is_ignored_app "${appid}" "${name}" && continue
      appids+=("${appid}"); names+=("${name}")
    done
    shopt -u nullglob
  done < <(collect_steamapps_dirs "${steam_dir}")

  if (( ${#appids[@]} == 0 )); then
    if [[ "${MODE}" == "list" ]]; then
      die "No installed Steam games found under ${steam_dir}."
    fi
    # Still prune previously generated configs so launchers for games that have
    # since been uninstalled do not linger.
    log "No installed Steam games found under ${steam_dir}."
    mkdir -p "${CONFIGS_DIR}"
    remove_stale_generated
    echo "Removed any previously generated launcher configs."
    return
  fi

  log "Detected ${#appids[@]} installed Steam game(s) in ${WINEPREFIX}"

  if [[ "${MODE}" == "list" ]]; then
    local i
    for i in "${!appids[@]}"; do
      local note=""
      is_curated "${appids[$i]}" && note="  [curated config exists]"
      printf '  %-8s %s%s\n' "${appids[$i]}" "${names[$i]}" "${note}"
    done
    return
  fi

  mkdir -p "${CONFIGS_DIR}"
  remove_stale_generated

  local written=0 skipped=0 i file
  for i in "${!appids[@]}"; do
    if is_curated "${appids[$i]}"; then
      printf '  skip   %-8s %s (curated config already exists)\n' "${appids[$i]}" "${names[$i]}"
      skipped=$((skipped + 1))
      continue
    fi
    file="$(write_config "${appids[$i]}" "${names[$i]}")"
    printf '  write  %-8s %s -> %s\n' "${appids[$i]}" "${names[$i]}" "${file##*/}"
    written=$((written + 1))
  done

  log "Wrote ${written} generated config(s); skipped ${skipped} curated."

  if [[ "${MODE}" == "install" ]]; then
    log "Building launchers via install_cosmos.command"
    "${SCRIPT_DIR}/install_cosmos.command"
  else
    echo "Next: run ./install_cosmos.command to build the .app launchers into '/Applications/Cosmos Apps'."
  fi
}

main "$@"
